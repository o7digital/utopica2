---
import Layout from '../layouts/Layout.astro';

const title = 'Utópica — Consultoría de ventas B2B con IA | CDMX';
const description =
  'Instalamos sistemas comerciales que funcionan aunque nadie esté mirando — y escalan sin contratar más vendedores.';

const statusQuo = [
  {
    title: 'Competidores inferiores ganan tus clientes.',
    description:
      'Cada mes sin mensaje claro, empresas con peor servicio cierran los deals que tú deberías cerrar. Porque ellos comunican mejor.',
  },
  {
    title: 'Tu tiempo libre deja de existir.',
    description:
      'Toda venta importante pasa por tu cabeza. Vacaciones, fines de semana, noches — el negocio corre detrás de ti.',
  },
  {
    title: 'La brecha con quien usa IA bien se abre.',
    description:
      'Equipos que ya integraron IA en su proceso comercial no van más rápido — van acelerando. La distancia no es lineal. Es exponencial.',
  },
];

const services = [
  {
    id: 'S.01',
    title: 'Prospección sin depender del fundador',
    description:
      'Reuniones con tu cliente ideal que no dependen de quien es el más carismático del equipo.',
    duration: '14 semanas',
  },
  {
    id: 'S.02',
    title: 'Calificación que decide antes de gastar preventa',
    description:
      'Saber qué oportunidad vale propuesta — y cuál descalificar temprano.',
    duration: '12 semanas',
  },
  {
    id: 'S.03',
    title: 'Venta consultiva que no depende de la estrella',
    description:
      'Tu equipo cierra como tu mejor cerrador — con business case propio, sin descontar.',
    duration: '12 semanas',
  },
  {
    id: 'S.04',
    title: 'Coaching IA que no desaparece cuando termina el programa',
    description:
      'Feedback automático después de cada reunión. El cambio de comportamiento que otras capacitaciones prometen y nunca sostienen.',
    duration: '4 semanas de instalación + permanente post',
  },
  {
    id: 'S.05',
    title: 'Proyectos IA para procesos que no son ventas',
    description:
      'Agentes y skills personalizadas para cualquier proceso repetitivo — comerciales o no.',
    duration: 'Variable (6–16 semanas según alcance)',
  },
];

const fitYes = [
  'Tu equipo cierra cuando tú estás. No cierra cuando no estás.',
  'Vendes servicios de alto ticket ($300k+) con ciclo largo.',
  'Ya exploraste IA y sabes que no es magia — quieres aplicarla con método.',
  'Facturas consistente pero no encuentras cómo escalar sin contratar el doble.',
];

const fitNo = [
  'Buscas “agencia que genere 25 reuniones en 3 meses o devuelve dinero”.',
  'Vendes productos transaccionales con ciclo corto por canales masivos.',
  'No tienes ticket mediano-alto — un sistema es caro para tu margen.',
  'Esperas que la IA haga el trabajo sin tu equipo aprenderlo.',
];

const scheduleHref =
  (import.meta.env.PUBLIC_RECLAIM_URL as string | undefined) ||
  'https://app.reclaim.ai/m/gael/sesion-estrategica-claridad-comercial';
---

<Layout title={title} description={description}>
  <div class="bg-[#f7f5f2] text-[#111111] transition-colors duration-300 dark:bg-[#0b0c0e] dark:text-white">
    <section class="relative flex h-[80vh] items-center overflow-hidden pt-20" aria-labelledby="homepage-hero-title">
      <div class="absolute inset-0">
        <img
          src="/images/utopica2.jpg"
          alt="Equipo de negocio trabajando en una mesa"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/60"></div>
      </div>

      <div class="relative mx-auto w-full max-w-7xl px-6">
        <div class="max-w-4xl">
          <p class="mb-4 text-sm font-medium tracking-[0.18em] text-white/78">
            Utópica · CDMX · Ventas B2B con IA
          </p>
          <h1 id="homepage-hero-title" class="text-5xl font-semibold leading-[0.95] text-white lg:text-6xl">
            Tu calidad no se refleja en tus ventas.
            <br />
            Eso es una injusticia comercial.
          </h1>
          <p class="mt-6 text-lg text-white/80">
            Instalamos sistemas comerciales que funcionan aunque nadie esté mirando — y escalan sin contratar más vendedores.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={scheduleHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-black transition hover:bg-white/90"
            >
              Agendar diagnóstico
            </a>
            <a
              href="#status-quo"
              class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-white transition hover:bg-white/10"
            >
              Cómo funciona
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="status-quo" class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="status-quo-title">
      <div class="max-w-3xl">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          § I · El costo del status quo
        </p>
        <h2 id="status-quo-title" class="mt-3 text-3xl font-semibold md:text-4xl">
          Cuando tu mejor vendedor toma vacaciones, las ventas caen.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[#555555] dark:text-white/70">
          Y cada semana que pasa, la situación se amplía. Esto es lo que se acumula mientras el sistema comercial depende de una sola cabeza.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {statusQuo.map((item) => (
          <article class="rounded-xl border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-[#121317]">
            <h3 class="text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#555555] dark:text-white/70">
              {item.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-y border-black/10 px-6 py-20 dark:border-white/10" aria-labelledby="injusticia-title">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          § II · Injusticia comercial
        </p>
        <h2 id="injusticia-title" class="mt-3 max-w-3xl text-3xl font-semibold md:text-4xl">
          La calidad de tu trabajo te da el derecho a competir. No te garantiza la victoria.
        </h2>
        <p class="mt-6 max-w-4xl text-base leading-relaxed text-[#555555] dark:text-white/70">
          Cuando competidores con peor servicio te ganan clientes porque comunican mejor, no es mala suerte. Es un problema de sistema.
        </p>
        <p class="mt-4 max-w-4xl text-base leading-relaxed text-[#555555] dark:text-white/70">
          Para ganar, necesitas un mensaje que le haga justicia a tu servicio — y un equipo capaz de venderlo sin depender de ti. Eso es libertad comercial.
        </p>
      </div>
    </section>

    <section id="servicios" class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="services-title">
      <div class="max-w-3xl">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          § III · Servicios
        </p>
        <h2 id="services-title" class="text-3xl font-semibold md:text-4xl">
          Cinco capacidades que se instalan.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-[#555555] dark:text-white/70">
          Se combinan según dónde está hoy tu cuello de botella. No todas aplican a todos — por eso empezamos con un diagnóstico.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {services.map((service) => (
          <article class="rounded-xl border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-[#121317]">
            <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
              {service.id}
            </p>
            <h3 class="mt-3 text-xl font-semibold leading-snug">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#555555] dark:text-white/70">
              {service.description}
            </p>
            <p class="mt-4 text-sm font-medium text-black/70 dark:text-white/75">
              Duración: {service.duration}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-y border-black/10 px-6 py-20 dark:border-white/10" aria-labelledby="ia-title">
      <div class="mx-auto max-w-5xl">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          § IV · El rol de la IA
        </p>
        <h2 id="ia-title" class="text-3xl font-semibold md:text-4xl">
          La IA no va a vender por ti.
        </h2>
        <p class="mt-3 text-xl text-black/75 dark:text-white/80">
          Pero puede hacer que tu equipo venda como tu mejor cerrador.
        </p>
        <p class="mt-6 max-w-4xl text-base leading-relaxed text-[#555555] dark:text-white/70">
          Usamos IA donde amplifica al humano: prospección, calificación, coaching post-reunión, research de cuentas, preparación de propuestas.
        </p>
        <div class="mt-6 rounded-xl border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-[#121317]">
          <p class="text-base leading-relaxed text-[#555555] dark:text-white/70">
            No la usamos donde el juicio humano es insustituible: cerrar relaciones, negociar contratos sensibles, decidir estrategia.
          </p>
        </div>
        <p class="mt-6 max-w-4xl text-lg font-medium leading-relaxed text-black dark:text-white">
          El equipo humano toma decisiones. La IA ejecuta el trabajo repetitivo. Un equipo de 5 opera como uno de 15.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="founder-title">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/10">
          <img
            src="/images/team/optimized/gael-thome-new.jpg"
            alt="Gaël Thomé"
            class="h-full w-full object-cover"
          />
        </div>
        <div>
          <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
            § V · Quién lo opera
          </p>
          <h2 id="founder-title" class="text-3xl font-semibold md:text-4xl">
            Gaël Thomé
          </h2>
          <p class="mt-6 text-base leading-relaxed text-[#555555] dark:text-white/70">
            Fundé Utópica después de vivir el problema desde el otro lado: construir un servicio que los clientes adoraban pero que no escalaba porque dependía de mi tiempo, mi energía, mi cabeza.
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#555555] dark:text-white/70">
            La salida fue sistematizar todo — lo que hoy instalamos en otras consultoras medianas. Un equipo que cierra sin ti. Un pipeline que se sostiene. Una conversación comercial con IA amplificando a la gente, no reemplazándola.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
              <p class="text-sm font-medium text-black/45 dark:text-white/45">Base</p>
              <p class="mt-2 font-semibold">CDMX</p>
            </div>
            <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
              <p class="text-sm font-medium text-black/45 dark:text-white/45">Opera desde</p>
              <p class="mt-2 font-semibold">2022</p>
            </div>
            <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
              <p class="text-sm font-medium text-black/45 dark:text-white/45">Clientes</p>
              <p class="mt-2 font-semibold">Consultoras 50–1000</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-black/10 px-6 py-20 dark:border-white/10" aria-labelledby="fit-title">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          § VI · Para quién
        </p>
        <h2 id="fit-title" class="text-3xl font-semibold md:text-4xl">
          Honesto antes de cobrarte.
        </h2>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <div class="rounded-xl border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-[#121317]">
            <h3 class="text-2xl font-semibold">Sí — probablemente somos tu fit</h3>
            <ul class="mt-6 space-y-4 text-sm leading-relaxed text-[#555555] dark:text-white/70">
              {fitYes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-[#121317]">
            <h3 class="text-2xl font-semibold">No — mejor busca en otro lado</h3>
            <ul class="mt-6 space-y-4 text-sm leading-relaxed text-[#555555] dark:text-white/70">
              {fitNo.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 text-center" aria-labelledby="final-cta-title">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-sm font-medium tracking-[0.16em] text-black/45 dark:text-white/45">
          Siguiente paso
        </p>
        <h2 id="final-cta-title" class="text-3xl font-semibold md:text-4xl">
          30 minutos para ver si esto te aplica.
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-[#555555] dark:text-white/70">
          Una conversación. Sin pitch. Sin compromiso. Describes tu situación, mapeamos dónde está tu cuello de botella, y decidimos juntos si tiene sentido trabajar — o si conviene otro camino.
        </p>
        <div class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
            <p class="text-sm font-medium text-black/45 dark:text-white/45">Duración</p>
            <p class="mt-2 font-semibold">30 minutos</p>
          </div>
          <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
            <p class="text-sm font-medium text-black/45 dark:text-white/45">Costo</p>
            <p class="mt-2 font-semibold">Cero</p>
          </div>
          <div class="rounded-xl border border-black/10 bg-white p-4 dark:border-white/10 dark:bg-[#121317]">
            <p class="text-sm font-medium text-black/45 dark:text-white/45">Compromiso</p>
            <p class="mt-2 font-semibold">Ninguno</p>
          </div>
        </div>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href={scheduleHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-black px-6 py-3 text-white transition hover:bg-black/90 dark:bg-white dark:text-black dark:hover:bg-white/90"
          >
            Agendar diagnóstico
          </a>
          <a
            href="/marcos-venta"
            class="inline-flex items-center justify-center rounded-full border border-black/15 px-6 py-3 text-black transition hover:bg-black/5 dark:border-white/15 dark:text-white dark:hover:bg-white/10"
          >
            Explorar primero los marcos
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
